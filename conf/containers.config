/*
 * ═══════════════════════════════════════════════════════════════════════════════
 * Container Image Specifications
 * ═══════════════════════════════════════════════════════════════════════════════
 * 
 * Build containers at: https://seqera.io/containers/
 * 
 * For each module, select the packages listed in the corresponding environment.yml
 * and paste the resulting container URL below.
 * 
 * This file is only loaded when using --with-singularity, --with-apptainer, or
 * --with-docker
 * ═══════════════════════════════════════════════════════════════════════════════
 */

process {

    // ═══════════════════════════════════════════════════════════════════════════
    // BWA (modules/bwa/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: bwa=0.7.19, samtools=1.21
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:bwa_index|.*:bwa_mem|.*:bwa_aln|.*:bwa_mem_singlereads' {
        container = 'oras://community.wave.seqera.io/library/bwa_samtools:53e8560a3a85daad'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Samtools (modules/samtools/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: python>=3.8, samtools=1.23.1, bedtools=2.31.1
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:samtools_.*|.*:mergebams|.*:merge_.*|.*:cramqc|.*:extract_sample_from_bam|.*:index_reference|.*:parse_region_depths|.*:samtools_bam2cram' {
        container = 'oras://community.wave.seqera.io/library/bedtools_samtools_python:af882a81ebe2e6a5'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // BCFtools (modules/bcftools/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: bcftools=1.23.1
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:bcftools_concat|.*:bcftools_filter.*|.*:bcftools_merge|.*:bcftools_norm|.*:select_indels|.*:select_snps|.*:select_invariant|.*:mpileup' {
        container = 'oras://community.wave.seqera.io/library/bcftools:1.23.1--116b8d34f8b326ac'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Bedtools (modules/bedtools/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: bedtools>=2.26.0, bcftools=1.23.1
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:callability_filter|.*:callable_regions|.*:combine_bedfiles|.*:finalize_masks|.*:mappability_filter' {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools:8a85de4af61726e9'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // FastQC (modules/fastqc/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: fastqc=0.12.1
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:fastqc.*' {
        container = 'oras://community.wave.seqera.io/library/fastqc:0.12.1--a74c1c66ecc610d5'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Fastp (modules/fastp/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: fastp=1.3.6
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:fastp' {
        container = 'oras://community.wave.seqera.io/library/fastp:1.3.6--e50b9f45179b51cd'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Freebayes (modules/freebayes/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: freebayes=1.3.10, bcftools=1.21, samtools=1.21
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:freebayes' {
        container = 'oras://community.wave.seqera.io/library/bcftools_freebayes_samtools:5e7a40adac200788'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // GATK (modules/gatk/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: gatk4, bcftools
    // Note: Use latest versions from bioconda
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:combine_gvcfs|.*:create_sequence_dict|.*:filter_indels|.*:filter_snps|.*:gatk_mark_duplicates|.*:genotype_gvcfs.*|.*:haplotype_caller.*|.*:merge_filtered_vcfs|.*:select_.*_gatk' {
        container = 'oras://community.wave.seqera.io/library/bcftools_gatk4:af8ac37cfb98bd15'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // BBMap (modules/bbmap/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: bbmap=39.06
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:clumpify.*' {
        container = 'oras://community.wave.seqera.io/library/bbmap:39.06--fa9df961eff07a13'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MultiQC (modules/multiqc/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: multiqc=1.33
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:multiqc.*' {
        container = 'oras://community.wave.seqera.io/library/multiqc:1.33--cce4fd3641b8050c'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MapDamage (modules/mapdamage/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: mapdamage2=2.2.3, samtools=1.23.1, r-gam
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:damage_profiler.*|.*:damageprofiler.*' {
        container = 'oras://community.wave.seqera.io/library/mapdamage2_samtools_r-gam:1726251457a6a971'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Qualimap (modules/qualimap/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: qualimap=2.3, samtools=1.23.1
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:qualimap' {
        container = 'oras://community.wave.seqera.io/library/qualimap_samtools:eaff150ec753cd3e'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // AdapterRemoval (modules/adapterremoval/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: adapterremoval=2.3.4
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:adapterremoval' {
        container = 'oras://community.wave.seqera.io/library/adapterremoval:2.3.4--f74964afddea8191'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // SeqKit (modules/seqkit/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: seqkit=2.13.0
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:seqkit.*' {
        container = 'oras://community.wave.seqera.io/library/seqkit:2.13.0--4cc296e17e90b043'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Custom Variant Filters (modules/custom_variant_filters/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: python>=3.8, pysam=0.23.3, bcftools=1.23.1, bedtools=2.31.1
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:ab_dp_filter|.*:ab_filter|.*:ab_stats' {
        container = 'oras://community.wave.seqera.io/library/bcftools_bedtools_pysam_python:8dcb322a263d25a5'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Reference Intervals (modules/reference_intervals/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: python>=3.8
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:dochunks|.*:make_chunks' {
        container = 'oras://community.wave.seqera.io/library/python:3.14.7--629fbce4f44dac86'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Summary Stats (modules/summary_stats/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: python>=3.8, pandas, numpy
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:parse_summary_stats|.*:combine_summary.*' {
        container = 'oras://community.wave.seqera.io/library/numpy_pandas_python:be9c159be8300bea'
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // Variant Stats (modules/variant_stats/environment.yml)
    // ───────────────────────────────────────────────────────────────────────────
    // Required packages: python>=3.8, pysam=0.23.3, numpy=2.4.4, pandas=3.0.2,
    //                    r-base>=4.0, r-tidyverse, r-knitr, r-rmarkdown, r-scales
    // Note: This is a complex multi-tool container
    // ═══════════════════════════════════════════════════════════════════════════
    withName: '.*:vcfstats|.*:plot_.*|.*:parse_invars|.*:add_invariant_sites' {
        container = 'oras://community.wave.seqera.io/library/pysam_numpy_pandas_python_pruned:c8af3388e575b8a9'
    }
}
